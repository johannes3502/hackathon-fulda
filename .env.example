# Local development only. Copy this file to .env; do not commit .env.
POSTGRES_DB=trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_PORT=5432

S3_ACCESS_KEY=trainer-local
S3_SECRET_KEY=local-storage-change-me
S3_BUCKET=recordings
S3_PORT=8333

API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Separate worker processes; keep this modest on a development laptop.
CELERY_WORKER_CONCURRENCY=2

# German post-recording ASR. Default: local faster-whisper, no cloud API.
# The model is downloaded at image build time (WHISPER_MODEL, default small).
# Set ASR_PROVIDER=json only for the explicit synthetic demo.
# Set ASR_PROVIDER=deepgram to use the optional hosted EU endpoint instead.
ASR_PROVIDER=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=de
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false
# Optional vocabulary hint, e.g. "äh, ähm, öh"; empty by default.
WHISPER_INITIAL_PROMPT=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Live transcription via WS /speech/live. Same local model, slightly different
# knobs: windows of ~2 s of new audio decode on a 10 s rolling context window.
# Defaults fall back to the WHISPER_* values above.
#WHISPER_LIVE_MODEL=tiny
#WHISPER_LIVE_BEAM_SIZE=1
#WHISPER_LIVE_CHUNK_MS=2000
#WHISPER_LIVE_MAX_WINDOW_MS=10000
#WHISPER_LIVE_MAX_SECONDS=600
#WHISPER_LIVE_MAX_IDLE_SECONDS=30

# Source uploads (RAG): local German embedding model inside the containers.
# EMBEDDING_PROVIDER=none disables vectors; search then uses keywords only.
EMBEDDING_PROVIDER=local
SOURCE_MAX_BYTES=26214400

# Native Ollama on the demo laptop (Metal on macOS); no hosted fallback.
OLLAMA_URL=http://host.docker.internal:11434
COACH_MODEL=qwen3.5:4b-q4_K_M
# Fact-check: any OpenAI-compatible chat endpoint (OpenAI, Ollama, vLLM, ...).
# Leave LLM_BASE_URL/LLM_MODEL empty to use local Ollama. Transcript sentences are
# sent to this endpoint. Examples:
#   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=<model>   LLM_API_KEY=sk-...
#   LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=<ollama model>
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# false if the server rejects response_format=json_object.
LLM_JSON_MODE=true
# Empty = provider default; some reasoning models reject other values.
LLM_TEMPERATURE=
LLM_TIMEOUT_S=90
LLM_CONCURRENCY=4

# Second source when uploads do not settle a claim: none, wikipedia (no key)
# or tavily (TAVILY_API_KEY). Search queries leave the system.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_LANGUAGE=de
TAVILY_API_KEY=
