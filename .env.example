# Local development only. Copy this file to .env; do not commit .env.
POSTGRES_DB=trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_PORT=5432

S3_ACCESS_KEY=trainer-local
S3_SECRET_KEY=local-storage-change-me
S3_BUCKET=recordings
S3_PORT=8333

API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Separate worker processes; keep this modest on a development laptop.
CELERY_WORKER_CONCURRENCY=2

# German post-recording ASR; audio is sent to Deepgram's EU endpoint.
# Leave the key empty for local-only jobs (transcribe=false).
# ASR_PROVIDER=json explicitly replays the synthetic demo word timestamps.
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
