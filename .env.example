# Local development only. Copy this file to .env; do not commit .env.
POSTGRES_DB=trainer
POSTGRES_USER=trainer
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_PORT=5432

S3_ACCESS_KEY=trainer-local
S3_SECRET_KEY=local-storage-change-me
S3_BUCKET=recordings
S3_PORT=8333

API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Separate worker processes; keep this modest on a development laptop.
CELERY_WORKER_CONCURRENCY=2

# German post-recording ASR. Default: local faster-whisper, no cloud API.
# The model is downloaded at image build time (WHISPER_MODEL, default small).
# Set ASR_PROVIDER=json only for the explicit synthetic demo.
# Set ASR_PROVIDER=deepgram to use the optional hosted EU endpoint instead.
ASR_PROVIDER=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=de
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=false
# Optional vocabulary hint, e.g. "äh, ähm, öh"; empty by default.
WHISPER_INITIAL_PROMPT=
# Live-Studio: "Stream transcription with Deepgram (EU)" streams during recording.
# Final words/timestamps are reused for review, without a second ASR request.
# Keep this secret on the backend. No key or stream failure -> local Whisper after stop.
DEEPGRAM_API_KEY=
# Optional ElevenLabs question round. Private agent; leave the saved First message empty.
# Enable System prompt and First message overrides. See docs/07-review-and-agent.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
DEEPGRAM_MODEL=nova-3

# Legacy local preview via WS /speech/live (start without provider=deepgram). Same model, different
# knobs: windows of ~2 s of new audio decode on a 10 s rolling context window.
# Defaults fall back to the WHISPER_* values above.
#WHISPER_LIVE_MODEL=tiny
#WHISPER_LIVE_BEAM_SIZE=1
#WHISPER_LIVE_CHUNK_MS=2000
#WHISPER_LIVE_MAX_WINDOW_MS=10000
#WHISPER_LIVE_MAX_SECONDS=600
#WHISPER_LIVE_MAX_IDLE_SECONDS=30

# Source uploads (RAG): local German embedding model inside the containers.
# EMBEDDING_PROVIDER=none disables vectors; search then uses keywords only.
EMBEDDING_PROVIDER=local
SOURCE_MAX_BYTES=26214400

# Gemini via its OpenAI-compatible endpoint. The key stays on the backend.
# `GEMINI_API_KEY` and `GOOGLE_API_KEY` are aliases only for Google's HTTPS host.
# For any other compatible endpoint, set LLM_API_KEY explicitly if required.
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Fast/cheap test default. Use gemini-3.8-flash for the final pass.
LLM_MODEL=gemini-3.1-flash-lite
# An explicitly empty LLM_BASE_URL or LLM_MODEL disables the LLM features.
LLM_API_KEY=
# false if the server rejects response_format=json_object.
LLM_JSON_MODE=true
# Empty = provider default; some reasoning models reject other values.
LLM_TEMPERATURE=
LLM_TIMEOUT_S=45
LLM_CONCURRENCY=4
# Note: the Gemini Developer API is cloud processing without EU region pinning.
# Send only synthetic demo data, or use Vertex AI for EU residency.

# Second source when uploads do not settle a claim: none, wikipedia (no key)
# or tavily (TAVILY_API_KEY). Search queries leave the system.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_LANGUAGE=de
TAVILY_API_KEY=
