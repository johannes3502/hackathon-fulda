{
  "name": "hackathon-fulda",
  "private": true,
  "workspaces": [
    "frontend",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:compose": "node --test scripts/compose.test.mjs",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "api:export": "node scripts/export-openapi.mjs",
    "api:types": "openapi-typescript api/openapi.json -o api/schema.d.ts",
    "api:generate": "npm run api:export && npm run api:types",
    "api:check": "npm run api:export -- --check && npm run api:types -- --check",
    "mobile": "npm run start --workspace mobile",
    "mobile:ios": "npm run ios --workspace mobile",
    "mobile:android": "npm run android --workspace mobile",
    "postinstall": "node -e \"if(require('node:fs').existsSync('mobile/scripts/patch-native.cjs'))require('./mobile/scripts/patch-native.cjs')\""
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1"
  }
}
