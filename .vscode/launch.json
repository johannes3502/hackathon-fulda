{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: local FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.dev",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    }
  ]
}
