      "Body_analyze_speech_analyze_post": {
        "properties": {
          "config": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "AudioConfig JSON; first 3000 ms are calibration",
            "title": "Config"
          },
