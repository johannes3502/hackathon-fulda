        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Word": {
        "properties": {
          "end_ms": {
            "minimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          },
          "word": {
            "title": "Word",
            "type": "string"
          }
        },
        "required": [
          "word",
          "start_ms",
          "end_ms"
        ],
        "title": "Word",
        "type": "object"
      },
      "WordAnalysis": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "title": "Events",
            "type": "array"
          },
          "heuristics": {
            "additionalProperties": true,
            "title": "Heuristics",
            "type": "object"
          },
          "summary": {
            "$ref": "#/components/schemas/WordSummary"
          }
        },
        "required": [
          "summary",
          "events",
          "heuristics"
        ],
        "title": "WordAnalysis",
        "type": "object"
      },
      "WordConfig": {
        "properties": {
          "fillers": {
            "items": {
              "type": "string"
            },
            "title": "Fillers",
            "type": "array"
          },
          "pace_fast_ratio": {
            "default": 1.3,
            "exclusiveMinimum": 1.0,
            "title": "Pace Fast Ratio",
            "type": "number"
          },
          "pace_min_words": {
            "default": 5,
            "minimum": 1.0,
            "title": "Pace Min Words",
            "type": "integer"
          },
          "pace_slow_ratio": {
            "default": 0.7,
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Pace Slow Ratio",
            "type": "number"
          },
          "pace_window_ms": {
            "default": 10000,
            "exclusiveMinimum": 0.0,
            "title": "Pace Window Ms",
            "type": "integer"
          },
          "pause_min_ms": {
            "default": 2000,
            "minimum": 0.0,
            "title": "Pause Min Ms",
            "type": "integer"
          },
          "repetition_max_gap_ms": {
            "default": 1000,
            "minimum": 0.0,
            "title": "Repetition Max Gap Ms",
            "type": "integer"
          }
        },
        "title": "WordConfig",
        "type": "object"
      },
      "WordSummary": {
        "description": "Measured values only; no score or grade.",
        "properties": {
          "filler_count": {
            "title": "Filler Count",
            "type": "integer"
          },
          "median_window_wpm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Window Wpm"
          },
          "pause_count": {
            "title": "Pause Count",
            "type": "integer"
          },
          "repetition_count": {
            "title": "Repetition Count",
            "type": "integer"
          },
          "speaking_duration_ms": {
            "title": "Speaking Duration Ms",
            "type": "integer"
          },
          "word_count": {
            "title": "Word Count",
            "type": "integer"
          },
          "words_per_minute": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Words Per Minute"
          }
        },
        "required": [
          "word_count",
          "speaking_duration_ms",
          "words_per_minute",
          "pause_count",
          "filler_count",
          "repetition_count",
          "median_window_wpm"
        ],
        "title": "WordSummary",
        "type": "object"
      }
    }
  },
